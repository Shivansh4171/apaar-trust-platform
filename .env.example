# Replace these placeholders with local-only values before starting Docker Compose.
POSTGRES_USER=REPLACE_WITH_LOCAL_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD
POSTGRES_DB=apaar_trust
DATABASE_URL=postgresql://REPLACE_WITH_LOCAL_DB_USER:REPLACE_WITH_URL_SAFE_RANDOM_PASSWORD@127.0.0.1:5433/apaar_trust
API_PORT=4000
WEB_PORT=5173
APP_ORIGIN=http://localhost:5173
# Empty uses an ephemeral key in development; set a random 48+ character value for stable local sessions.
SESSION_SECRET=
# Production must set this to the number of trusted TLS reverse-proxy hops.
TRUST_PROXY_HOPS=0
