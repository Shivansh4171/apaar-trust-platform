generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  VERIFIED
  UNVERIFIED
  PENDING
  DISPUTED
  REPORTED
}

enum DiscrepancyField {
  REFERENCE
  FULL_NAME
  PROGRAM
}

enum DiscrepancyStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum ReviewActor {
  STUDENT_DEMO
  INSTITUTION_DEMO
  AICTE_ADMIN
  INSTITUTION_ADMIN
  INSTITUTION_OPERATOR
  STUDENT
  REVIEWER
}

enum UserRole {
  AICTE_ADMIN
  INSTITUTION_ADMIN
  INSTITUTION_OPERATOR
  STUDENT
  REVIEWER
}

enum ReviewEventAction {
  SUBMITTED
  REVIEW_UPDATED
}

model Institution {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  students  StudentRecord[]
  users     User[]
}

model StudentRecord {
  id            String       @id @default(cuid())
  institutionId String
  reference     String
  fullName      String
  program       String
  status        RecordStatus @default(UNVERIFIED)
  synthetic     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  confirmations StudentConfirmation[]
  discrepancies DiscrepancyReport[]
  corrections   StudentRecordCorrection[]
  studentUser   User?         @relation("StudentAccount")

  @@unique([institutionId, reference])
  @@index([institutionId, status])
}

model StudentConfirmation {
  id              String        @id @default(cuid())
  studentRecordId String
  synthetic       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  actorUserId     String?
  actorUser       User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([studentRecordId, createdAt])
}

model DiscrepancyReport {
  id               String                  @id @default(cuid())
  studentRecordId  String
  field            DiscrepancyField
  institutionValue String                  @db.VarChar(120)
  claimedValue     String                  @db.VarChar(120)
  reason           String                  @db.VarChar(1000)
  status           DiscrepancyStatus       @default(OPEN)
  resolutionNote   String?                 @db.VarChar(1000)
  synthetic        Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  studentRecord    StudentRecord           @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  history          DiscrepancyReportEvent[]

  @@index([studentRecordId, status])
  @@index([status, createdAt])
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique @db.VarChar(254)
  passwordHash    String       @db.VarChar(255)
  role            UserRole
  institutionId   String?
  studentRecordId String?      @unique
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  institution     Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  studentRecord   StudentRecord? @relation("StudentAccount", fields: [studentRecordId], references: [id], onDelete: Restrict)
  confirmations   StudentConfirmation[]
  reviewEvents    DiscrepancyReportEvent[]
  correctionEvents StudentRecordCorrection[]

  @@index([institutionId, role])
}

model StudentRecordCorrection {
  id              String        @id @default(cuid())
  studentRecordId String
  previousValues  Json
  newValues       Json
  reason          String        @db.VarChar(1000)
  actorEmail      String        @db.VarChar(254)
  actorRole       UserRole
  actorUserId     String?
  createdAt       DateTime      @default(now())
  studentRecord   StudentRecord @relation(fields: [studentRecordId], references: [id], onDelete: Restrict)
  actorUser       User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([studentRecordId, createdAt])
}

model AuthSession {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
}

model DiscrepancyReportEvent {
  id                  String            @id @default(cuid())
  discrepancyReportId String
  actor               ReviewActor
  action              ReviewEventAction
  fromStatus          DiscrepancyStatus?
  toStatus            DiscrepancyStatus
  note                String?           @db.VarChar(1000)
  createdAt           DateTime          @default(now())
  discrepancyReport   DiscrepancyReport  @relation(fields: [discrepancyReportId], references: [id], onDelete: Cascade)
  actorUserId         String?
  actorUser           User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([discrepancyReportId, createdAt])
}
